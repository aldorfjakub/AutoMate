# SQLite database file used by the gateway and the workers.
DATABASE_URL=sqlite:project_db.sqlite

# Redis instance backing the job queue and live match streams.
REDIS_URL=redis://127.0.0.1:6379

# GitHub OAuth app credentials.
# Create an app at https://github.com/settings/developers
OAUTH_CLIENT_ID=your_github_oauth_client_id
OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# Callback URL registered for the OAuth app, URL-encoded.
# Local dev default: http://localhost:5173/auth/callback
# URL-encoded form:  http%3A%2F%2Flocalhost%3A5173%2Fauth%2Fcallback
OAUTH_CALLBACK=http%3A%2F%2Flocalhost%3A5173%2Fauth%2Fcallback